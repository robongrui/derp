#version 450
#extension GL_GOOGLE_include_directive : require
// Sky light and occlusion (bakeAmbient in scene3d/bake_indirect.cpp): each
// sample casts the same cosine-weighted rays round its normal (pattern, in
// the hemisphere's own frame, made by the processor as cosineDirection makes
// them) and counts those that reach the sky and how open the rest find it
// within 64 units.
layout(local_size_x=64) in;
#ifdef METAL
#define MAP_BINDING 1
#define SAMPLE_BINDING 2
#define PATTERN_BINDING 3
#define OUT_BINDING 4
#else
#define MAP_BINDING 0
#define SAMPLE_BINDING 1
#define PATTERN_BINDING 2
#define OUT_BINDING 0
#endif
// job: x the first sample, y how many, z rays a sample; reach: w's float (infinite: the sky is sought).
layout(std140,set=2,binding=0) uniform Job { uvec4 mapA; uvec4 mapB; uvec4 job; };
layout(std430,set=0,binding=MAP_BINDING) readonly buffer MapWords { uint mapWords[]; };
// Two words of four a sample: x, y, z, sector | flags << 24; normal, -.
layout(std430,set=0,binding=SAMPLE_BINDING) readonly buffer Samples { uvec4 samples[]; };
layout(std430,set=0,binding=PATTERN_BINDING) readonly buffer Pattern { vec4 pattern[]; };
// Rays that reached the sky; openness summed over the rays.
layout(std430,set=1,binding=OUT_BINDING) writeonly buffer Out { vec2 results[]; };
#include "trace.glsl"
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=job.y)return;
    uint s=job.x+i;
    uvec4 a=samples[2u*s],b=samples[2u*s+1u];
    vec3 o=vec3(uintBitsToFloat(a.x),uintBitsToFloat(a.y),uintBitsToFloat(a.z));
    vec3 normal=vec3(uintBitsToFloat(b.x),uintBitsToFloat(b.y),uintBitsToFloat(b.z));
    int sector=int(a.w&0xFFFFFFu);
    uint flags=a.w>>24;
    float reach=uintBitsToFloat(job.w);
    // The frame as cosineDirection makes it.
    vec3 helper=abs(normal.z)<0.9?vec3(0.0,0.0,1.0):vec3(1.0,0.0,0.0);
    vec3 tangent=cross(helper,normal);
    tangent/=sqrt(dot(tangent,tangent));
    vec3 bitangent=cross(normal,tangent);
    float sky=0.0,open=0.0;
    for(uint n=0u;n<job.z;++n) {
        vec4 p=pattern[n];
        vec3 d=tangent*p.x+bitangent*p.y+normal*p.z;
        TraceHit hit;
        if(traceRay(sector,o,d,reach,flags,hit)) {sky+=reach==traceInf?1.0:0.0;open+=1.0;continue;}
        if(hit.kind==hitNone) {open+=1.0;continue;}
        vec3 h=o+d*hit.at-o;
        open+=min(1.0,sqrt(dot(h,h))/64.0);
    }
    results[i]=vec2(sky,open);
}
