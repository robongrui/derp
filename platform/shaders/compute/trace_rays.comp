#version 450
#extension GL_GOOGLE_include_directive : require
// Rays given one by one (scene3d/gpu_trace.cpp's GpuRay), traced as
// traceRay does: what they met comes back one record a ray. The trace check
// uses it, and the bakes whose rays are few or irregular.
layout(local_size_x=64) in;
#ifdef METAL
#define MAP_BINDING 1
#define RAY_BINDING 2
#define OUT_BINDING 3
#else
#define MAP_BINDING 0
#define RAY_BINDING 1
#define OUT_BINDING 0
#endif
// job: x the first ray, y how many.
layout(std140,set=2,binding=0) uniform Job { uvec4 mapA; uvec4 mapB; uvec4 job; };
layout(std430,set=0,binding=MAP_BINDING) readonly buffer MapWords { uint mapWords[]; };
// Two words of four a ray: x, y, z, sector | flags << 24; direction, length.
layout(std430,set=0,binding=RAY_BINDING) readonly buffer Rays { uvec4 rays[]; };
// open | skyward << 1 | kind << 4 | part << 8; sector; line; where it stopped (ray length).
layout(std430,set=1,binding=OUT_BINDING) writeonly buffer Out { uvec4 results[]; };
#include "trace.glsl"
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=job.y)return;
    uint r=job.x+i;
    uvec4 a=rays[2u*r],b=rays[2u*r+1u];
    vec3 o=vec3(uintBitsToFloat(a.x),uintBitsToFloat(a.y),uintBitsToFloat(a.z));
    vec3 d=vec3(uintBitsToFloat(b.x),uintBitsToFloat(b.y),uintBitsToFloat(b.z));
    int sector=int(a.w&0xFFFFFFu);
    if(sector==0xFFFFFF)sector=-1;
    TraceHit hit;
    bool open=traceRay(sector,o,d,uintBitsToFloat(b.w),a.w>>24,hit);
    results[i]=uvec4((open?1u:0u)|(hit.skyward?2u:0u)|(uint(hit.kind)<<4)|(uint(hit.part)<<8),uint(hit.sector),uint(hit.line),floatBitsToUint(hit.at));
}
