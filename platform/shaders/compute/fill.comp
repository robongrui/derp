#version 450
// The smallest kernel: each word of the buffer set from its index, for the
// compute layer's own check (DERP_GPUTRACECHECK runs it first).
layout(local_size_x=64) in;
#ifdef METAL
#define OUT_BINDING 1
#else
#define OUT_BINDING 0
#endif
layout(std140,set=2,binding=0) uniform Job { uvec4 job; };   // x count, y seed
layout(std430,set=1,binding=OUT_BINDING) writeonly buffer Out { uint words[]; };
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i<job.x)words[i]=i*3u+job.y;
}
